<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="2dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/prev_day"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/prev_day"
            android:src="@drawable/ic_back" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/date_button"
            style="@style/Widget.EasyLedger.FieldButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/date"
            android:textAlignment="center"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/next_day"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/next_day"
            android:rotation="180"
            android:src="@drawable/ic_back" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/yesterday_button"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="2dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/yesterday"
            android:textSize="12sp"
            app:cornerRadius="11dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/today_button"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/today"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="@color/brand"
            app:cornerRadius="11dp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/type_toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_card"
        android:padding="3dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/type_expense"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="@string/expense"
            android:textStyle="bold"
            app:backgroundTint="@color/expense_soft"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/type_income"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="@string/income"
            android:textStyle="bold"
            app:cornerRadius="14dp" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <TextView
        android:id="@+id/category_prompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/pick_category_prompt"
        android:textColor="@color/neutral"
        android:textSize="13sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/category_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="4dp" />

    <LinearLayout
        android:id="@+id/details_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/amount_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_amount_expense"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/amount_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/amount"
                android:textColor="@color/expense_deep"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/amount_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:gravity="end"
                android:includeFontPadding="false"
                android:text="0"
                android:textColor="@color/expense"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="원"
                android:textColor="@color/neutral"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/quick_amount_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quick_amount_button_1"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:textSize="13sp"
                android:visibility="gone"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quick_amount_button_2"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:textSize="13sp"
                android:visibility="gone"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quick_amount_button_3"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:textSize="13sp"
                android:visibility="gone"
                app:cornerRadius="10dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/quick_amount_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/quick_amount_empty"
            android:textColor="@color/neutral"
            android:textSize="11sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <com.google.android.material.button.MaterialButton android:id="@+id/key_1" style="@style/Widget.EasyLedger.Key" android:text="1" />
                <com.google.android.material.button.MaterialButton android:id="@+id/key_2" style="@style/Widget.EasyLedger.Key" android:text="2" />
                <com.google.android.material.button.MaterialButton android:id="@+id/key_3" style="@style/Widget.EasyLedger.Key" android:text="3" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <com.google.android.material.button.MaterialButton android:id="@+id/key_4" style="@style/Widget.EasyLedger.Key" android:text="4" />
                <com.google.android.material.button.MaterialButton android:id="@+id/key_5" style="@style/Widget.EasyLedger.Key" android:text="5" />
                <com.google.android.material.button.MaterialButton android:id="@+id/key_6" style="@style/Widget.EasyLedger.Key" android:text="6" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <com.google.android.material.button.MaterialButton android:id="@+id/key_7" style="@style/Widget.EasyLedger.Key" android:text="7" />
                <com.google.android.material.button.MaterialButton android:id="@+id/key_8" style="@style/Widget.EasyLedger.Key" android:text="8" />
                <com.google.android.material.button.MaterialButton android:id="@+id/key_9" style="@style/Widget.EasyLedger.Key" android:text="9" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/key_00"
                    style="@style/Widget.EasyLedger.Key"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="00" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/key_0"
                    style="@style/Widget.EasyLedger.Key"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="0" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/key_000"
                    style="@style/Widget.EasyLedger.Key"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="000" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/key_del"
                    style="@style/Widget.EasyLedger.Key"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/key_backspace"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:padding="0dp"
                    app:icon="@drawable/ic_backspace"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/neutral" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/payment_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pay_cash"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/cash"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pay_card"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/card"
                app:cornerRadius="12dp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/memo_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@android:color/transparent"
            android:hint="@string/memo_hint"
            android:inputType="textCapSentences"
            android:maxLength="200"
            android:minHeight="36dp"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="2dp"
            android:text="@string/save"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/brand_deep"
            app:cornerRadius="14dp"
            app:elevation="2dp" />
    </LinearLayout>
</LinearLayout>
